# Python
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.eggs/
build/
dist/
.wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example
*.local

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Generated project data and outputs
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# Logs
*.log
# Downloaded external datasets (keep source data out of Git by default)
data/external/*
!data/external/.gitkeep

# Evaluation outputs are reproducible artifacts
outputs/evaluation/*
